{
  "name": "@aivin-labs/cli",
  "version": "1.0.4",
  "description": "aivin CLI - scaffold, run, and deploy Aivin plugins built on @aivin-labs/sdk",
  "type": "module",
  "bin": {
    "aivin": "bin/cli.mjs"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --test test/cli.validate.test.mjs"
  },
  "keywords": [
    "aivin",
    "plugin",
    "cli",
    "sdk",
    "scaffold"
  ],
  "author": "Aivin Team",
  "license": "MIT",
  "dependencies": {
    "@aivin-labs/sdk": "^1.1.2",
    "axios": "^1.18.1",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "inquirer": "^14.0.2",
    "react": "^19.2.8",
    "socket.io-client": "^4.8.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  },
  "files": [
    "bin/**/*",
    "docs/**/*",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aivin-labs/cli.git"
  },
  "bugs": {
    "url": "https://github.com/aivin-labs/cli/issues"
  },
  "homepage": "https://github.com/aivin-labs/cli#readme"
}
