{
  "manifest_version": 3,
  "name": "AIVIN Cast",
  "version": "1.2.0",
  "description": "Phát màn hình tab của panel Trình duyệt qua WebRTC — chỉ BE điều khiển qua CDP.",
  "key": "",
  "minimum_chrome_version": "116",
